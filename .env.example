PORT=8787
NODE_ENV=production

# --- Live lookup API keys (set on Render Environment) ---
# Providers accept primary name OR alias where noted.

HIBP_API_KEY=

# Hunter.io (primary) - also accepts HUNTERIO_API_KEY
HUNTER_API_KEY=

NUMVERIFY_API_KEY=

# AbuseIPDB (primary) - also accepts ABUSEPDB_API_KEY
ABUSEIPDB_API_KEY=

SHODAN_API_KEY=
VIRUSTOTAL_API_KEY=

# Aliases / optional
HUNTERIO_API_KEY=
ABUSEPDB_API_KEY=
LEAKCHECK_API_KEY=
SECURITYTRAILS_API_KEY=
WHOISXML_API_KEY=
URLSCAN_API_KEY=
SERP_API_KEY=

# --- Rate limiting (inbound, per client IP) ---
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX=30
# RATE_LIMIT_SCAN_MAX=12

# --- Outbound provider throttle (ms between calls) ---
# THROTTLE_HIBP_MS=1600
# THROTTLE_HUNTER_MS=1200
# THROTTLE_SHODAN_MS=1000
# THROTTLE_VIRUSTOTAL_MS=15000
